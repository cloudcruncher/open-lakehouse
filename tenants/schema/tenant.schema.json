{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-lakehouse.local/schemas/tenant/v1",
  "title": "Tenant",
  "description": "A team that builds on the platform from its own repo (ADR 14). The platform reconciles this file into Kafka topics, Polaris namespaces, a Keycloak group and a Dagster code location.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "domain", "description", "owner", "topics", "namespaces", "codeLocation"],
  "properties": {
    "apiVersion": { "const": "open-lakehouse/v1" },
    "kind": { "const": "Tenant" },
    "name": {
      "description": "Team id; the file must be tenants/<name>.yaml. The Keycloak group is tenant-<name>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "domain": {
      "description": "Prefix the team owns: topics start with <domain>. and namespaces with <domain>_.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,19}$"
    },
    "description": { "type": "string", "minLength": 10, "maxLength": 300 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "email", "repo"],
      "properties": {
        "team": { "type": "string", "minLength": 3 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
        "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "partitions", "retentionHours", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$" },
          "partitions": { "type": "integer", "minimum": 1, "maximum": 12 },
          "retentionHours": {
            "description": "Kappa replays from Kafka, so retention bounds how far back a team can reprocess.",
            "type": "integer", "minimum": 1, "maximum": 720
          },
          "cleanupPolicy": { "enum": ["delete", "compact"], "default": "delete" },
          "description": { "type": "string", "minLength": 5 }
        }
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*_[a-z0-9_]+$" }
    },
    "codeLocation": {
      "description": "The team's Dagster gRPC code server.",
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "module"],
      "properties": {
        "image": {
          "description": "A pinned tag; 'latest' would let a tenant change what runs without a PR here.",
          "type": "string",
          "pattern": "^[a-z0-9./_-]+:(?!latest$)[A-Za-z0-9._-]+$"
        },
        "module": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$" },
        "deploy": {
          "description": "Run the code server. False until the team has published its first image: provisioning comes first.",
          "type": "boolean",
          "default": false
        },
        "memoryMb": { "type": "integer", "minimum": 512, "maximum": 4096, "default": 1536 }
      }
    },
    "services": {
      "description": "Long-running workloads (producers, streaming jobs), run next to the code server with the same identity, on the data and Kafka networks only.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "image", "memoryMb"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
          "description": { "type": "string", "minLength": 10 },
          "image": {
            "description": "A pinned tag, as for codeLocation.image; usually the same image with another command.",
            "type": "string",
            "pattern": "^[a-z0-9./_-]+:(?!latest$)[A-Za-z0-9._-]+$"
          },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "memoryMb": {
            "description": "Hard limit; counts against the platform's tenant memory budget.",
            "type": "integer", "minimum": 128, "maximum": 4096
          },
          "stateVolume": {
            "description": "A volume at /state that survives restarts, e.g. for streaming checkpoints.",
            "type": "boolean", "default": false
          },
          "secrets": {
            "description": "Names from the tenant's `secrets`; each is rendered as <NAME>_ENV_FILE pointing at /run/tenant-secrets/<name>.env.",
            "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" }
          },
          "deploy": { "type": "boolean", "default": false }
        }
      }
    },
    "secrets": {
      "description": "Secret slots the team fills itself (`make tenant-secret`): the values never enter git; the platform stores them in the tenant's own folder of its secrets volume.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
