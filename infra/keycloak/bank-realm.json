{
  "realm": "bank",
  "enabled": true,
  "displayName": "Open Lakehouse (demo bank)",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "passwordPolicy": "length(12)",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "agent-console",
      "name": "Colleague agent console (Live Call Assist UI)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/*"
      },
      "protocolMappers": [
        {
          "name": "audience-mcp-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-call-assist",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "call-assist",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcp-gateway",
      "name": "MCP data gateway (acts on behalf of colleagues)",
      "publicClient": false,
      "secret": "${MCP_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "trino",
      "name": "Trino query engine (resource server)",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "trino-cli",
      "name": "Direct SQL access for analysts (Trino CLI / BI tools)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "call-assist",
      "name": "Live Call Assist backend (resource server)",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "grafana",
      "name": "Grafana (platform dashboards, SSO)",
      "publicClient": false,
      "secret": "${GRAFANA_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/login/generic_oauth"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      }
    },
    {
      "clientId": "prometheus",
      "name": "Prometheus scraper (machine identity, metrics only)",
      "publicClient": false,
      "secret": "${PROMETHEUS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "dagster-ui",
      "name": "Dagster UI via oauth2-proxy (platform admins)",
      "publicClient": false,
      "secret": "${DAGSTER_UI_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3002/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:3002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-dagster-ui",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dagster-ui",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lineage-ui",
      "name": "Lineage UI (Marquez) via oauth2-proxy",
      "publicClient": false,
      "secret": "${LINEAGE_UI_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3003/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:3003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-lineage-ui",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lineage-ui",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "superset",
      "name": "Superset (SQL workbench, SSO; queries Trino as the signed-in colleague)",
      "publicClient": false,
      "secret": "${SUPERSET_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3004/oauth-authorized/keycloak",
        "http://localhost:3004/api/v1/database/oauth2/"
      ],
      "webOrigins": [
        "http://localhost:3004"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3004/*"
      },
      "protocolMappers": [
        {
          "name": "audience-trino",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trino",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Contact-Centre",
      "email": "alice@bank.example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Complaints",
      "email": "bob@bank.example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol",
      "firstName": "Carol",
      "lastName": "Analyst",
      "email": "carol@bank.example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "ops_admin",
      "firstName": "Ops",
      "lastName": "Admin",
      "email": "ops@bank.example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
