{
 "uid": "platform-slos",
 "title": "Platform SLOs \u2014 agents on live calls",
 "description": "Golden signals and SLO burn for the agent data path. Alert rules: infra/prometheus/rules/slo.yml",
 "editable": false,
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "open-lakehouse"
 ],
 "timezone": "utc",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Agent tool calls (MCP gateway) \u2014 SLO: 99.9% available, p95 < 500 ms, p99 < 1.5 s",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Availability (range)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - ((sum(increase(mcp_tool_calls_total{outcome=~\"unavailable|error\"}[$__range])) or vector(0)) / clamp_min(sum(increase(mcp_tool_calls_total[$__range])) or vector(0), 1))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
